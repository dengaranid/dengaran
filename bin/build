#!/usr/bin/env bash
# Build Dengaran ke public/: minify CSS dan JS, tag SEO, _headers, robots.txt, sitemap.xml, 404.html.
#
#   bin/build            jalankan scripts/build_public.py
#
# Hasilnya sama dengan build di Cloudflare Pages. Untuk melihatnya di browser: bin/dev --public

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Warna ANSI hanya kalau stream itu terminal dan NO_COLOR (https://no-color.org) kosong.
# Dicek di sini, bukan di dalam paint: di dalam $(...) stdout adalah pipe, jadi -t 1 selalu gagal.
# Pemakaian: paint <fd> <kode> <teks>, misalnya paint 2 "1;31" "Error".
COLOR_1=""
COLOR_2=""
if [ -z "${NO_COLOR:-}" ] && [ "${TERM:-}" != "dumb" ]; then
  [ -t 1 ] && COLOR_1=1
  [ -t 2 ] && COLOR_2=1
fi
paint() {
  local enabled="COLOR_$1"
  if [ -n "${!enabled}" ]; then
    printf '\033[%sm%s\033[0m' "$2" "$3"
  else
    printf '%s' "$3"
  fi
}

case "${1:-}" in
  "") ;;
  -h|--help)
    sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
  *)
    echo "$(paint 2 "1;31" "Argumen tidak dikenal:") $1" >&2
    echo "Pakai: $(paint 2 1 "bin/build")" >&2
    exit 1
    ;;
esac

exec python3 "$ROOT/scripts/build_public.py"
