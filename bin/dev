#!/usr/bin/env bash
# Server preview lokal untuk Dengaran.
#
#   bin/dev              sajikan src/ di port 8080 (perubahan langsung terlihat setelah reload)
#   bin/dev --public     build ke public/ lalu sajikan public/ (versi minify, sama dengan deploy)
#   bin/dev 3000         pakai port lain; bisa juga lewat PORT=3000 bin/dev
#
# http.server tidak membaca public/_headers, jadi CSP dan cache baru bisa dicek sesudah deploy.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PORT="${PORT:-8080}"
DIR="src"

for arg in "$@"; do
  case "$arg" in
    --public) DIR="public" ;;
    -h|--help)
      sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    ''|*[!0-9]*)
      echo "Argumen tidak dikenal: $arg" >&2
      echo "Pakai: bin/dev [--public] [port]" >&2
      exit 1
      ;;
    *) PORT="$arg" ;;
  esac
done

port_in_use() {
  lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1
}

# Port dicek sebelum build, supaya public/ tidak ditulis ulang kalau server gagal jalan.
# Saran perintahnya memakai flag yang sama dan port bebas berikutnya, kalau ada dalam 20 port.
if port_in_use "$PORT"; then
  echo "Port $PORT sudah dipakai proses lain." >&2
  FLAG=""
  [ "$DIR" = "public" ] && FLAG=" --public"
  NEXT=""
  for candidate in $(seq $((PORT + 1)) $((PORT + 20))); do
    if ! port_in_use "$candidate"; then
      NEXT="$candidate"
      break
    fi
  done
  if [ -n "$NEXT" ]; then
    echo "Pakai port lain: bin/dev$FLAG $NEXT" >&2
  else
    echo "Pakai port lain: bin/dev$FLAG <port>" >&2
  fi
  exit 1
fi

if [ "$DIR" = "public" ]; then
  "$ROOT/bin/build"
fi

echo "Menyajikan $DIR/ di http://localhost:$PORT/ (Ctrl+C untuk berhenti)"
exec python3 -m http.server "$PORT" --bind 127.0.0.1 --directory "$ROOT/$DIR"
